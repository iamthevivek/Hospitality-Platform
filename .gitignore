# ====================================================================
# Hospitality Platform - Git Ignore Rules
# Protects all environment secrets, credentials, build artifacts & IDE files
# ====================================================================

# Secrets & Environment Variables (NEVER COMMIT)
.env
.env.*
!.env.example
*.env
*.key
*.pem
*.pfx
*.p12
*.jks
secrets/
credentials/

# Node.js & Frontend Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Java & Backend Artifacts
target/
backend/target/
*.class
*.jar
*.war
*.ear
backend/.mvn/.develocity/

# Logs & Temporary Files
*.log
logs/
temp/
tmp/
*.tmp
*.bak
*.swp
*.swo

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Files
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
